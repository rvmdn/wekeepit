# Contoh Konfigurasi Server Produksi WeKeepIt (.env)
NODE_ENV=production
PORT=4321
HOST=0.0.0.0
ALLOW_REMOTE_HOST=true

# Aktifkan multi-user autentikasi & RBAC (Admin, Editor, Viewer)
AUTH_ENABLED=true

# Lokasi penyimpanan data persisten server
DATA_FILE_PATH=/var/lib/wekeepit/wekeepit-data.json
SCHEMA_FILE_PATH=/var/lib/wekeepit/metadata-schema.json
USERS_FILE_PATH=/var/lib/wekeepit/users.json
INDEX_DB_PATH=/var/lib/wekeepit/index.db
